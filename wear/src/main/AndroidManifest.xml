<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      startForeground() with the connectedDevice type throws SecurityException
      unless the app holds, at the moment of the call, either a granted RUNTIME
      Bluetooth permission or one of a small set of normal permissions.
      CHANGE_NETWORK_STATE is normal and therefore auto-granted at install, which
      satisfies the requirement with no runtime prompt. That is a real benefit on a
      watch-sized screen, and it means the service can start before the activity
      has ever run. We do not touch Bluetooth APIs ourselves; the Data Layer does
      not need BLUETOOTH_CONNECT.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!--
          Declares this as a standalone Wear app: it does not require a matching
          phone-side app to be installed from the Play Store. Our phone app is
          sideloaded, so the pairing check must not gate us.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!--
          exported=true is required for the complication's tap PendingIntent to
          start it, and it makes `am start` and instrumented tests possible.
          Because it is
          exported it must not perform any privileged action merely on launch:
          it does not open a session, does not emit input, and does not take
          keepScreenOn until the user genuinely interacts.
        -->
        <activity
            android:name=".ScrollRemoteActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Owns the session and the phone link. Not exported: anything that can
          reach mintSeqAndSend from an Intent would turn this app into a signing
          oracle for input events.
        -->
        <service
            android:name=".WatchLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          Receives the phone's status backchannel. Must be exported so Google Play
          services can bind it; the path filter keeps the surface narrow, and the
          payload is treated as advisory only.
        -->
        <service
            android:name=".WatchStatusListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/remote-input/v1/" />
            </intent-filter>
        </service>

        <!--
          Publishes link status into a watch-face complication slot.

          Everything here is load-bearing for the provider being OFFERED in the
          picker, not just for it working once placed:
            - android:label must be non-empty; it is the picker row text.
            - android:icon must be set; the picker renders it beside the label.
            - the BIND_COMPLICATION_PROVIDER permission and exported=true are what
              let the watch-face host bind us; without both we are skipped.
            - SUPPORTED_TYPES must intersect the slot's own supported types or we
              are absent from that specific slot and it looks like filtering.
          UPDATE_PERIOD_SECONDS is 0 because updates are pushed on state changes;
          any non-zero value would wake this service on a timer all day.
        -->
        <service
            android:name=".LinkComplicationService"
            android:description="@string/complication_description"
            android:exported="true"
            android:icon="@drawable/ic_complication"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE,SMALL_IMAGE,ICON" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

    </application>

</manifest>
