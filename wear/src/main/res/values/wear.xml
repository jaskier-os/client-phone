<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities">

    <!--
      Advertises this node's capability so the phone can find the watch via
      CapabilityClient. tools:keep is required: R8 has no reference to this array
      (Google Play services reads it by name at runtime) and would otherwise strip
      it, leaving capability discovery silently empty.
    -->
    <string-array name="android_wear_capabilities">
        <item>watch_input_source</item>
    </string-array>
</resources>
