<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <TextureView
        android:id="@+id/arStreamTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/txtArStreamStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:text="@string/ar_stream_connecting"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="#99000000"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnPhoneMic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ar_stream_phone_mic_on"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:src="@drawable/ic_mic_phone_on"
            app:tint="@color/gbx_orange" />

        <ImageButton
            android:id="@+id/btnGlassesMic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ar_stream_glasses_mic_on"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:src="@drawable/ic_mic_glasses_on"
            app:tint="@color/gbx_orange" />
    </LinearLayout>
</FrameLayout>
