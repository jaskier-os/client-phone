<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities">

    <!--
      Advertises this node so the watch can find the phone via CapabilityClient.
      tools:keep is required: R8 has no reference to this array (Google Play
      services reads it by name at runtime) and would strip it, leaving capability
      discovery silently empty.
    -->
    <string-array name="android_wear_capabilities">
        <item>phone_input_sink</item>
    </string-array>
</resources>
